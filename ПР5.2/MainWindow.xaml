<Window x:Class="ПР5._2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ПР5._2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800"
        Background="AntiqueWhite">
    <StackPanel Orientation="Vertical" Margin="0,20,0,20" HorizontalAlignment="Center" Width="400" Background="Azure">
        <Label Margin="0,20,0,20" Content="Введите номер" HorizontalAlignment="Center"/> 
        <TextBox x:Name="textBoxNumber" Width="250px" HorizontalAlignment="Center"/>

        <Button Content="Проверить корректность номера" Click="ButtonCheck_Click" Margin="0,15,0,15" Width="200"/>
        <Separator/>
        <Button x:Name="ButtonUpg" Content="Увеличить номер" Click="ButtonUpg_Click" Margin="0,15,0,15" Width="200" IsEnabled="False"/>
    </StackPanel>
</Window>
